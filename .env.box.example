# loldata-cron on the box - the values prod ran (2026-09), secrets blanked.
# bun auto-loads .env from the WorkingDirectory; the systemd unit sets nothing.
RIOT_API_KEY=                      # PRODUCTION key (500:10s / 30000:10min per host)
SUPABASE_URL=http://localhost:8000 # the box's own Kong
SUPABASE_KEY=                      # the box SERVICE_ROLE key
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5433/postgres
SEASON_START_EPOCH=
INGEST_REGIONS=EUW,EUNE,NA,KR      # all four; EUW-only = 1 of 3 match hosts = ~1/3 throughput
RIOT_LIMIT_10S=350                 # PER HOST; europe shares the key with the backend's live backfill
RIOT_LIMIT_10MIN=21000
INGEST_BATCH=24
DISCOVERY_BATCH=15000              # rank=NULL EUW backlog claimed per pass via claim_discovery_batch(n); 0 disables
PROCESS_TIERS=EMERALD,DIAMOND
MAX_NEW_MATCHES=200                # per-player cap per pass = wide net; games beyond are recaptured via teammates
# CDN sync (loldata-cdn-sync.timer): R2 bucket loldata-cdn served as cdn2.loldata.cc
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=loldata-cdn
